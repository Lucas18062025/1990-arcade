# Headers de seguridad (Cloudflare Pages los aplica en cada deploy).
# X-Content-Type-Options y Referrer-Policy ya los envía Cloudflare: no duplicar.
# CSP allowlista lo justo: bundle propio + Firebase (gstatic) + Google Fonts.
# inline styles necesarios por plantillas de juegos (style="--ar" y <style> Tetris).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://www.gstatic.com https://firestore.googleapis.com wss://firestore.googleapis.com; object-src 'none'; base-uri 'self'
  Permissions-Policy: fullscreen=(self), autoplay=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
