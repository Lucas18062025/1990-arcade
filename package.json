{
  "name": "1990-arcade",
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build --mode preview && vite preview --port 4173",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm test && npm run build",
    "firebase:emulators": "firebase emulators:start --only auth,firestore",
    "firebase:rules": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  }
}
